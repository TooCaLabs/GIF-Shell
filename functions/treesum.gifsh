function treesum --description "Directory tree with file sizes and line counts"
    set -l root .
    set -l max_depth 4
    set -l show_hidden 0

    argparse 'd/depth=' 'a/all' 'help' -- $argv
    or return 1

    if set -q _flag_help
        echo "Usage: treesum [-d DEPTH] [-a] [DIR]"
        echo "  Tree with inline file sizes and line counts."
        return 0
    end

    if set -q _flag_depth
        set max_depth $_flag_depth
    end
    if set -q _flag_all
        set show_hidden 1
    end
    if test (count $argv) -gt 0
        set root $argv[1]
    end

    if not test -d $root
        echo "treesum: $root: Not a directory" >&2
        return 1
    end

    __gif_treesum_walk $root 0 $max_depth $show_hidden
end

function __gif_treesum_walk --argument-names path depth max_depth show_hidden
    set -l indent (string repeat -n $depth "│   ")
    set -l entries

    if test $show_hidden -eq 1
        set entries (command ls -A $path 2>/dev/null)
    else
        set entries (command ls $path 2>/dev/null)
    end

    if test $depth -eq 0
        set -l abs (builtin realpath $path 2>/dev/null; or echo $path)
        echo "$abs/"
    end

    set -l count (count $entries)
    set -l i 0
    for name in $entries
        set i (math $i + 1)
        set -l full "$path/$name"
        set -l connector
        if test $i -eq $count
            set connector "└── "
        else
            set connector "├── "
        end

        if test -d $full
            set -l nfiles (find $full -type f 2>/dev/null | wc -l | string trim)
            set -l size (__gif_human_size (du -sk $full 2>/dev/null | awk '{print $1 * 1024}'))
            echo "$indent$connector$name/  ($nfiles files, $size)"
            if test $depth -lt $max_depth
                __gif_treesum_walk $full (math $depth + 1) $max_depth $show_hidden
            end
        else if test -f $full
            set -l size (__gif_human_size (stat -f%z $full 2>/dev/null; or stat -c%s $full 2>/dev/null))
            set -l lines "?"
            if file -b --mime-type $full 2>/dev/null | string match -q 'text/*'
                or string match -qr '\.(gifsh|fish|sh|py|js|ts|tsx|jsx|rs|go|c|h|cpp|md|txt|json|yaml|yml|toml|css|html|rb|java)$' -- $name
                set lines (wc -l < $full 2>/dev/null | string trim)
            end
            if test "$lines" = "?"
                echo "$indent$connector$name  ($size)"
            else
                echo "$indent$connector$name  ($size, $lines lines)"
            end
        else
            echo "$indent$connector$name"
        end
    end
end

function __gif_human_size --argument-names bytes
    if test -z "$bytes"
        echo "?"
        return
    end
    if test $bytes -lt 1024
        echo "$bytes B"
    else if test $bytes -lt 1048576
        echo (math -s1 "$bytes / 1024")" K"
    else if test $bytes -lt 1073741824
        echo (math -s1 "$bytes / 1048576")" M"
    else
        echo (math -s1 "$bytes / 1073741824")" G"
    end
end
